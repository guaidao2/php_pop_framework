{
    "name": "guaidao2/php_pop_framework",
    "description": "php_pop_framework: PHP deserialization POP chain generator that parses a codebase, finds gadget chains and builds payloads.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "guaidao2"
        },
        {
            "name": "coolmoon"
        }
    ],
    "require": {
        "php": ">=8.1",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "PopChain\\": "src/"
        }
    },
    "bin": [
        "popchain",
        "bin/popchain"
    ],
    "scripts": {
        "test": "php tests/run.php",
        "test:symbolic": "php tests/symbolic/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
